# OrbitFlare last-hop capture — Frankfurt box
# Vendor must send shreds to PUBLIC_IP:UDP_PORT
# Paper mode: capture only. Never sendTransaction. Never leader_send.

PUBLIC_IP=195.242.152.178
BIND_IP=0.0.0.0
UDP_PORT=20001

# Caps live on the data volume. /home/louis/captures/orbitflare is a symlink.
CAPTURE_DIR=/data/bsc/captures/orbitflare
PREFIX=orbitflare
ROTATE_BYTES=2147483648
MIN_GB=40
DISK_ALARM_GB=40

# Root must never hit ENOSPC again. Guard / independently of capture-volume free space.
ROOT_FS=/
ROOT_MIN_GB=40
# Oldest closed .cap files are deleted when capture dir exceeds this.
RETAIN_MAX_GB=400
RETAIN_DAYS=2

# 48 cores. Last two isolated from general work.
CPU=47
REC_CPU=46

# Requested SO_RCVBUF. Kernel rmem_max is already 256 MiB.
RCVBUF=16777216

# paper = feed_live only. no hot send. no deploy. no arb.
PAPER=1
